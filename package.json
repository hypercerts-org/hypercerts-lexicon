{
  "name": "@hypercerts-org/lexicon",
  "version": "2.0.0",
  "description": "ATProto lexicon definitions and TypeScript types for the Hypercerts protocol",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "main": "./dist/records/index.js",
  "types": "./dist/records/index.d.ts",
  "sideEffects": [
    "./dist/index.mjs",
    "./dist/index.cjs",
    "./dist/lexicons.mjs",
    "./dist/lexicons.cjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/records/index.d.ts",
      "default": "./dist/records/index.js"
    },
    "./app/*": {
      "types": "./dist/records/app/*.d.ts",
      "default": "./dist/records/app/*.js"
    },
    "./com/*": {
      "types": "./dist/records/com/*.d.ts",
      "default": "./dist/records/com/*.js"
    },
    "./org/*": {
      "types": "./dist/records/org/*.d.ts",
      "default": "./dist/records/org/*.js"
    },
    "./pub/*": {
      "types": "./dist/records/pub/*.d.ts",
      "default": "./dist/records/pub/*.js"
    },
    "./legacy": {
      "types": "./dist/exports.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./lexicons": {
      "types": "./dist/lexicons.d.ts",
      "import": "./dist/lexicons.mjs",
      "require": "./dist/lexicons.cjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "legacy": [
        "./dist/exports.d.ts"
      ],
      "lexicons": [
        "./dist/lexicons.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "lexicons",
    "SCHEMAS.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "hypercerts",
    "atproto",
    "lexicon",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hypercerts-org/hypercerts-lexicon.git"
  },
  "scripts": {
    "list": "find ./lexicons -name '*.json'",
    "check": "pnpm gen-api && pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "build": "node ./scripts/build-legacy.js && pnpm build:types && pnpm build:records",
    "build:types": "tsc --project tsconfig.build.json",
    "build:records": "node -e \"require('fs').rmSync('dist/records',{recursive:true,force:true})\" && tsc --project tsconfig.records.json",
    "//permissions": "permission-set lexicons are published as-is but have no TS shape; lex gen-* cannot codegen them. scripts/run-lex-codegen.js runs a lex subcommand over all lexicons EXCEPT permission-sets (excluded by content \u2014 the same check generate-exports.js uses). It is a single Node process that spawns lex with the file list as argv and forwards lex's exit code, so a producer failure propagates without `set -o pipefail` (not portable across npm's sh) and shell word-splitting is avoided. (argv is still bounded by the OS execve arg limit, ~2 MB on Linux \u2014 far above this list.)",
    "gen-api": "node ./scripts/run-lex-codegen.js gen-api --yes ./generated && pnpm gen-index && pnpm gen-records",
    "gen-md": "node ./scripts/run-lex-codegen.js gen-md --yes ./lexicons.md",
    "gen-schemas-md": "node ./scripts/generate-schemas.js",
    "//gen-ts": "UNUSED - use gen-api instead",
    "gen-ts": "node ./scripts/run-lex-codegen.js gen-ts-obj > generated/DO-NOT-USE-lexicons.ts",
    "gen-index": "node ./scripts/generate-exports.js",
    "gen-records": "node ./scripts/generate-records.js",
    "check:package": "node ./scripts/check-package.js",
    "lex": "node ./node_modules/@atproto/lex-cli/dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . && pnpm format:check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "clean": "rm -rf dist generated",
    "style:check": "node ./scripts/check-lexicon-style.js",
    "prepublishOnly": "pnpm check && pnpm check:package",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm check && changeset publish",
    "prepare": "lefthook install && ./scripts/setup-merge-driver.sh"
  },
  "dependencies": {
    "@atproto/lexicon": "^0.6.0",
    "multiformats": "^13.3.6"
  },
  "devDependencies": {
    "@atproto/crypto": "^0.5.0",
    "@atproto/lex": "0.4.2",
    "@atproto/lex-cli": "^0.9.5",
    "@atproto/xrpc": "^0.7.5",
    "@biomejs/biome": "2.6.4",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@ipld/dag-cbor": "^10.0.1",
    "@types/node": "24.19.2",
    "lefthook": "2.2.2",
    "string-width": "^8.1.0",
    "typescript": "7.0.2",
    "viem": "^2.47.5",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@atproto/lex": "^0.4.2"
  }
}
