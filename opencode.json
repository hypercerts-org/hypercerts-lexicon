{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "node *": "deny",
      "pnpm exec biome *": "allow",
      "pnpm build": "allow",
      "pnpm build:types": "allow",
      "pnpm changeset": "deny",
      "pnpm check": "allow",
      "pnpm clean": "allow",
      "pnpm format": "allow",
      "pnpm format:check": "allow",
      "pnpm gen-api": "allow",
      "pnpm gen-index": "allow",
      "pnpm gen-md": "allow",
      "pnpm gen-schemas-md": "allow",
      "pnpm gen-ts": "allow",
      "pnpm lex": "allow",
      "pnpm lint": "allow",
      "pnpm list": "allow",
      "pnpm prepublishOnly": "deny",
      "pnpm release": "deny",
      "pnpm style:check": "allow",
      "pnpm test": "allow",
      "pnpm test:watch": "allow",
      "pnpm typecheck": "allow",
      "pnpm version-packages": "deny"
    }
  }
}
